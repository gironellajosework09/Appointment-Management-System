<mxfile host="drawio"><diagram name="Deployment and isolation"><mxGraphModel dx="1400" dy="900" grid="1" page="1" pageWidth="1400" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Deployment &amp; client isolation | logical boundaries, not a hosting topology" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1250" height="40" as="geometry"/></mxCell>
